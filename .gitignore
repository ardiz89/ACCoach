# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.Python

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# PyInstaller build artifacts
build/
dist/

# Local recorded laps / user data (lives in ~/Documents/ACCoach at runtime;
# this folder is stale dev data, not source)
laps/

# Logs and crash reports (written to ~/Documents/ACCoach/logs at runtime)
logs/
*.log

# Vendored Piper TTS (downloaded binary + neural voice model, ~98MB).
# Not source — fetch separately (see tools/render_cues.py / docs). Keep the script.
tools/piper/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Il modello vocale italiano di vosk (88 MB) sta accanto agli script che lo
# usano ma non nel repo: e' un artefatto scaricabile, e un binario di quella
# taglia nella storia di git non se ne va piu'. Vedi tools/voce/README.md.
tools/voce/vosk-model-*/
tools/voce/*.zip
tools/voce/parla.lock
tools/voce/assistente-udito.jsonl
